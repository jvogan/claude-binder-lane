{
  "schema_version": 1,
  "template_id": "claude-binder-lane.v1",
  "base_profile": "modal-first-run-floor.json",
  "overlay": {
    "top_level": {
      "profile": {
        "profile_id": "modal-platform",
        "production_scoring": false,
        "production_scoring_reason": "A guarded supplied-candidate run completed on Modal, but this generic multi-tool profile still lacks portable target-bound qualification for every selected arm.",
        "purpose": "Use user-owned Modal compute for the available platform environments.",
        "claim_level": "provider-canary",
        "published_predictor_deviations": [
          {
            "published_arm": "esmfold2",
            "status": "not_run",
            "reason": "A guarded run exercised ESMFold2-Fast, not this ESMFold2 full-MSA arm. Its target gate, environment identity, and anchor measurements remain separate."
          },
          {
            "published_arm": "protenix-v2",
            "status": "not_run",
            "reason": "The platform route uses Boltz as its second arm. No completed Modal comparison exists."
          }
        ]
      },
      "provider": {
        "provider_id": "modal",
        "surface": "claude-science-host-compute",
        "workspace": "__REQUIRED__",
        "credential_lane": "user-owned-modal",
        "access": "account-only",
        "persistent_root": "{{data_root}}",
        "artifact_return_mode": "authenticated-platform-files",
        "budget": {
          "maximum_spend_usd": "__REQUIRED__",
          "ceiling_stated_by": "__REQUIRED__",
          "currency": "USD",
          "pricing_source": "__REQUIRED__",
          "pricing_checked_at": "__REQUIRED__"
        },
        "lifecycle": {
          "no_retry": true,
          "verify_bundle_hash_before_run": true,
          "verify_artifact_hashes_after_run": true,
          "request_timeout_seconds": 1800,
          "keep_alive_seconds": 0
        }
      },
      "modal_platform": {
        "roster_tools": [
          {"decision": "sequence", "tool_id": "proteinmpnn"},
          {"decision": "primary-score", "tool_id": "esmfold2"},
          {"decision": "second-score", "tool_id": "boltz"}
        ],
        "promotion_destination": "__REQUIRED__",
        "picture_owner_stage": "render-structure-pictures",
        "approval_briefing": [
          "Jobs run on your own Modal account. Your budget pays.",
          "Two approvals are coming: one to set up the compute, one to submit the job.",
          "Declining either card aborts cleanly. Receipts record where the campaign stopped.",
          "If a selected environment reports hydration incomplete, hydrate its own cache before the first job.",
          "Artifacts survive only through promotion. The workspace is deleted six hours after it goes idle."
        ],
        "bindings": [
          {
            "stage_id": "generate-rfdiffusion",
            "adapter_id": "rfdiffusion-generator",
            "environment": "proteomics_rfd_diffdock_gpu",
            "gpu": "A100",
            "egress_domains": ["dl.fbaipublicfiles.com"],
            "weights": {
              "hydrated": false,
              "pin": "proteomics_rfd_diffdock_gpu.py HYDRATE exposes no checkpoint digest."
            },
            "concurrency": 1,
            "concurrency_limit": 10,
            "timeout_seconds": 1
          }
        ],
        "workflow_bindings": [
          {"decision": "target-research", "route": "session"},
          {"decision": "target-qualification", "route": "session"},
          {"decision": "target-fetch", "route": "session"},
          {"decision": "target-prepare", "route": "session"},
          {"decision": "site-selection", "route": "session"},
          {"decision": "site-picture", "route": "session"},
          {"decision": "backbone-generation", "environment": "proteomics_rfd_diffdock_gpu", "gpu": "A100", "egress_domains": ["dl.fbaipublicfiles.com"], "weights": "proteomics_rfd_diffdock_gpu.py defines the RFdiffusion command interface and HYDRATE details."},
          {"decision": "fallback-generation", "route": "session-or-modal", "todo": "The scaffold library is unsettled. Skill-tree search and package index search settle it."},
          {"decision": "sequence-design", "environment": "proteomics_gpu", "gpu": "A100-80GB", "egress_domains": ["api.colabfold.com", "huggingface.co", "*.hf.co", "chaiassets.com"], "weights": "proteomics_gpu.py does not declare a ProteinMPNN weight revision."},
          {"decision": "primary-score", "environment": "esmfold2_gpu", "gpu": "A100-80GB", "egress_domains": [], "weights": ["biohub/ESMFold2@1ebf0e3481a5184eb6171d40615c79e384b48796", "biohub/ESMFold2-Fast@b28d8ace5e05e61e5bec1e6820cfd3e221819d12"]},
          {"decision": "second-score", "environment": "proteomics_boltz_gpu", "gpu": "A100-80GB", "egress_domains": ["api.colabfold.com", "model-gateway.boltz.bio", "huggingface.co", "*.hf.co"], "weights": "proteomics_boltz_gpu.py has no pinned weight revision."},
          {"decision": "filter", "route": "session", "tools": ["check_ipsae.py", "check_sc_dockq.py"]},
          {"decision": "loop-control", "route": "session"},
          {"decision": "rank-counter-screen-report", "route": "session"},
          {"decision": "persist-artifacts", "route": "session"},
          {"decision": "final-picture", "route": "session"}
        ],
        "environment_catalog": [
          {"environment": "proteomics_rfd_diffdock_gpu", "gpu": "A100", "egress_domains": ["dl.fbaipublicfiles.com"]},
          {"environment": "esmfold2_gpu", "gpu": "A100-80GB", "egress_domains": []},
          {"environment": "proteomics_boltz_gpu", "gpu": "A100-80GB", "egress_domains": ["api.colabfold.com", "model-gateway.boltz.bio", "huggingface.co", "*.hf.co"]},
          {"environment": "proteomics_gpu", "gpu": "A100-80GB", "egress_domains": ["api.colabfold.com", "huggingface.co", "*.hf.co", "chaiassets.com"]},
          {"environment": "proteomics_openfold_gpu", "gpu": "A100-80GB", "egress_domains": ["api.colabfold.com"], "weights": ["of3-p2-155k.pt@af09eac4f29cef856633af07558cb143226fe95ebbef2c20921769d4a5f4bee4"]},
          {"environment": "proteomics_jax_gpu", "gpu": "A100", "egress_domains": ["api.colabfold.com"], "weights": "proteomics_jax_gpu.py HYDRATE provides no pinned model revision."}
        ]
      }
    },
    "adapter_overrides": [
      {
        "adapter_id": "rfdiffusion-generator",
        "environment_identity": "modal-env:proteomics_rfd_diffdock_gpu@spec_sha=__REQUIRED__",
        "source_revision": "RosettaCommons/RFdiffusion@2d0c003df46b9db41d119321f15403dec3716cd9",
        "model_revision": "__REQUIRED__",
        "environment": {
          "CLAUDE_BINDER_EXECUTION_ROUTE": "modal-platform",
          "CLAUDE_BINDER_MODAL_ENV": "proteomics_rfd_diffdock_gpu",
          "CLAUDE_BINDER_MODAL_IMAGE": "__REQUIRED__",
          "CLAUDE_BINDER_MODAL_VOLUMES": "__REQUIRED__"
        },
        "resources": {
          "cpu": 4,
          "gpu": 1,
          "memory_gb": 16,
          "gpu_memory_gb": 16,
          "container_image_digest": "__REQUIRED__"
        }
      },
      {
        "adapter_id": "proteinmpnn-designer",
        "environment": {
          "CLAUDE_BINDER_EXECUTION_ROUTE": "modal-platform",
          "CLAUDE_BINDER_MODAL_ENV": "proteomics_gpu",
          "CLAUDE_BINDER_MODAL_IMAGE": "__REQUIRED__",
          "CLAUDE_BINDER_MODAL_VOLUMES": "{}"
        }
      },
      {
        "adapter_id": "solublempnn-designer",
        "environment": {
          "CLAUDE_BINDER_EXECUTION_ROUTE": "modal-platform",
          "CLAUDE_BINDER_MODAL_ENV": "proteomics_gpu",
          "CLAUDE_BINDER_MODAL_IMAGE": "__REQUIRED__",
          "CLAUDE_BINDER_MODAL_VOLUMES": "{}"
        }
      },
      {
        "adapter_id": "esmfold2-predictor",
        "environment": {
          "CLAUDE_BINDER_EXECUTION_ROUTE": "modal-platform",
          "CLAUDE_BINDER_MODAL_ENV": "esmfold2_gpu",
          "CLAUDE_BINDER_MODAL_IMAGE": "__REQUIRED__",
          "CLAUDE_BINDER_MODAL_VOLUMES": "__REQUIRED__"
        }
      }
    ]
  }
}
