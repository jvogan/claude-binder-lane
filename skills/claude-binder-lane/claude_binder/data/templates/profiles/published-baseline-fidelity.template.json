            "artifact_id": "solublempnn-rfd3-candidates",
            "path_template": "{{attempt_dir}}/{{phase}}/sequence-candidate-manifest.jsonl",
            "kind": "jsonl",
            "minimum_count": 1,
            "smoke_minimum_count": 1,
            "records_per_count": 2,
            "required_fields": [
              "candidate_id",
              "parent_candidate_id",
              "origin_generator",
              "sequence_designer",
              "sequence_path",
              "sequence_sha256",
              "sequence_length",
              "structure_path",
              "structure_sha256",
