    "stage_overrides": [
      {
        "stage_id": "sequence-solublempnn-rfd3",
        "adapter_id": "solublempnn-designer-rfd3",
        "required_role": "sequence-designer",
        "description": "Design SolubleMPNN sequences for the rfdiffusion3 backbone arm. The published roster names SolubleMPNN and SolubleCaliby and no other designer, so every backbone-only generator is served by one of those two.",
        "depends_on": [
          "generate-rfdiffusion3"
        ],
        "inputs": [
          "generate-rfdiffusion3:rfdiffusion3-candidates"
        ],
        "outputs": [
