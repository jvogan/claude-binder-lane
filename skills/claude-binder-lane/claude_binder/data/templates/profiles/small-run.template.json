{
  "schema_version": 1,
  "template_id": "claude-binder-lane.v1",
  "base_profile": "full-ensemble.template.json",
  "overlay": {
    "top_level": {
      "profile": {
        "profile_id": "small-run",
        "purpose": "Run one RFdiffusion route, one ProteinMPNN design route, and ESMFold2-Fast co-folding for a small candidate set.",
        "claim_level": "candidate",
        "production_scoring": true,
        "baseline_fidelity": false,
        "scores_ungated": false,
        "published_predictor_deviations": [
          {
            "published_arm": "esmfold2",
            "status": "not_run",
            "reason": "This profile removes the inherited esmfold2-predictor adapter and its screen and rescore stages. The full-mode deployment revision, model revision, and environment identity are unmeasured. This profile runs ESMFold2-Fast only."
          },
          {
            "published_arm": "protenix-v2",
            "status": "not_run",
            "reason": "This profile removes the inherited protenix-v2-predictor adapter and its screen and rescore stages. Protenix v2 has no measured runnable deployment for this package. This profile runs ESMFold2-Fast only."
          }
        ]
      },
      "generation": {
        "minimum_generators": 1,
        "minimum_backbones_per_generator": 1,
        "minimum_scored_candidates_per_generator": 1,
        "generators": [
          {
            "id": "rfdiffusion3",
            "enabled": true,
            "mode": "backbone-only",
            "adapter_id": "rfdiffusion-generator",
            "backbone_count": 10,
            "command_stage": "generate-rfdiffusion"
          }
        ]
      },
      "sequence_design": {
        "sequences_per_backbone": 1,
        "designers": [
          {
            "id": "proteinmpnn",
            "enabled": true,
            "compatible_generators": [
              "rfdiffusion",
              "rfdiffusion3"
            ],
            "accepts_backbone_shapes": {
              "full-backbone": [],
              "c-alpha-trace": [
                "--ca-only"
              ]
            },
            "adapter_id": "proteinmpnn-designer",
            "command_stage": "sequence-proteinmpnn"
          }
        ]
      },
      "cofold": {
        "minimum_predictors": 1,
        "screen_seeds": [
          0
        ],
        "rescore_seeds": [
          0,
          1,
          2,
          3,
          4
        ],
        "predictors": [
          {
            "id": "esmfold2-fast",
            "enabled": true,
            "adapter_id": "esmfold2-fast-predictor",
            "screen_stage": "cofold-screen-esmfold2-fast",
            "rescore_stage": "cofold-rescore-esmfold2-fast"
          }
        ]
      },
      "runtime": {
        "run_root": "{{data_root}}/runs/{{run_id}}",
        "model_roster_path": "data/model-roster.json",
        "model_roster_evidence_root": "data/roster-evidence",
        "bundle_path": "{{data_root}}/runs/{{run_id}}/run-bundle",
        "maximum_generated_candidates": 2000,
        "maximum_screen_predictions": 20000,
        "maximum_rescore_predictions": 10000,
        "maximum_optimization_predictions": 10000
      }
    },
    "remove_adapters": [
      "genie3-generator",
      "proteinmpnn-designer-genie3",
      "solublempnn-designer",
      "esmfold2-predictor",
      "protenix-v2-predictor"
