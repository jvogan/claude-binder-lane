              "target_sha256",
              "candidate_id",
              "parent_candidate_id",
              "origin_generator",
              "sequence_designer",
              "sequence_path",
              "sequence_sha256",
              "sequence_length",
              "structure_path",
              "structure_sha256",
              "design_pose_path",
              "design_pose_sha256",
              "status"
            ],
            "publish_path": "candidates/candidate-manifest.jsonl"
          },
          {
            "artifact_id": "sequence-files",
            "path_template": "{{attempt_dir}}/{{phase}}/sequences/*.fasta",
            "kind": "fasta",
            "minimum_count": 1
          },
          {
            "artifact_id": "design-pose-files",
            "path_template": "{{attempt_dir}}/{{phase}}/poses/*.pdb",
            "kind": "pdb",
            "minimum_count": 1
          }
        ]
      },
      {
        "stage_id": "score-screen",
        "depends_on": [
