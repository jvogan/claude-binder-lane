              "candidate_id",
              "control_type",
              "control_role",
              "control_structure_sha256",
              "predictor",
              "model_revision",
              "seed",
              "phase",
              "status"
            ],
            "publish_path": "controls/control-observations.jsonl"
          }
        ],
        "fanout": {},
        "mode": "single",
        "timeout_minutes": 360,
        "heartbeat_seconds": 120
      },
      {
        "stage_id": "normalize-candidates",
        "depends_on": [
          "sequence-proteinmpnn"
        ],
        "inputs": [
          "sequence-proteinmpnn:proteinmpnn-candidates"
        ],
        "outputs": [
