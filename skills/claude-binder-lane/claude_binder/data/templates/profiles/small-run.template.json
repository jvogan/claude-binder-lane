        "stage_id": "control-calibration",
        "description": "Run every registered control through the configured predictor and publish raw observations with the calibration band.",
        "depends_on": [
          "runtime-check",
          "target-prepare",
          "stage-msa"
        ],
        "inputs": [
          "target-prepare:target-manifest",
          "run-bundle:controls",
