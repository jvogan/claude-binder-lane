{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-binder-lane/cofold-observation.v1",
  "title": "Cofold Observation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "target_id",
    "candidate_id",
    "generator",
    "predictor",
    "score_instrument",
    "attempt_id",
    "model_revision",
    "phase",
    "seed",
    "control_type",
    "control_role",
    "control_structure_sha256",
    "status",
    "filter_pass",
    "target_sha256",
    "sequence_sha256",
    "target_chain_id",
    "binder_chain_id",
    "design_pose_path",
    "design_pose_sha256",
    "raw_prediction_record_sha256",
    "chain_mapping"
  ],
  "properties": {
    "score_instrument": {"type": "string", "minLength": 1},
    "generator": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "control_type": {"enum": ["candidate", "positive", "negative"]},
    "control_role": {"type": ["string", "null"]},
    "control_structure_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "filter_pass": {"type": "boolean"},
    "target_chain_id": {"type": "string", "minLength": 1},
    "binder_chain_id": {"type": "string", "minLength": 1},
    "design_pose_path": {"type": "string", "minLength": 1},
    "predicted_complex_path": {"type": "string", "minLength": 1},
    "predicted_complex_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pae_path": {"type": "string", "minLength": 1},
    "pae_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric_source_path": {"type": "string", "minLength": 1},
    "metric_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_prediction_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chain_mapping": {"type": "object", "minProperties": 1},
    "aligned_target_residue_count": {"type": "integer", "minimum": 1},
    "target_alignment_rmsd": {"type": "number", "minimum": 0},
    "ipsae_implementation_revision": {"type": "string", "minLength": 1},
    "ipsae_interface_cutoff_angstrom": {"type": "number", "exclusiveMinimum": 0},
    "dockq_implementation_revision": {"type": "string", "minLength": 1},
    "site_scorer_revision": {"type": "string", "minLength": 1},
    "site_residue_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "site_contact_cutoff_angstrom": {"type": "number", "exclusiveMinimum": 0},
    "site_atom_selection": {"type": "string", "minLength": 1},
    "site_metric_basis": {"enum": ["design-pose", "selected-cofold-pose"]},
    "site_hotspot_source": {
      "enum": ["explicit", "site-fallback", "designed_complex", "published_epitope", "unconstrained"]
    },
    "site_hotspot_relationship": {
      "enum": ["same-as-site", "subset-of-site", "superset-of-site", "partially-overlaps-site", "disjoint-from-site", "unconstrained"]
    },
    "hotspot_recovery_duplicates_target_contact_recall": {"type": "boolean"},
    "phase": {"enum": ["screen", "optimization", "uniform-rescore"]},
    "seed": {"type": "integer"},
    "status": {"enum": ["scored", "failed"]},
    "mapping_status": {"enum": ["ok", "failed", "not-applicable"]},
    "ipsae_target_to_binder": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "ipsae_binder_to_target": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "ipsae_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "sc_dockq": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "dockq": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "fnat": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "interface_rmsd": {"type": ["number", "null"], "minimum": 0},
    "ligand_rmsd": {"type": ["number", "null"], "minimum": 0},
    "site_contact_iou": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "target_contact_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "target_contact_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "hotspot_recovery": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "offsite_contact_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "iptm": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "interface_pae": {"type": ["number", "null"], "minimum": 0},
    "interface_plddt": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "clash_count": {"type": ["integer", "null"], "minimum": 0},
    "contact_count": {"type": ["integer", "null"], "minimum": 0},
    "failure_code": {"type": "string", "minLength": 1},
    "failure_reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "scored"}}},
      "then": {
        "required": [
          "predicted_complex_path",
          "predicted_complex_sha256",
          "pae_path",
          "pae_sha256",
          "metric_source_path",
          "metric_source_sha256",
          "aligned_target_residue_count",
          "target_alignment_rmsd",
          "ipsae_implementation_revision",
          "ipsae_interface_cutoff_angstrom",
          "dockq_implementation_revision",
          "site_scorer_revision",
          "site_residue_map_sha256",
          "site_contact_cutoff_angstrom",
          "site_atom_selection",
          "site_metric_basis",
          "ipsae_target_to_binder",
          "ipsae_binder_to_target",
          "ipsae_min",
          "sc_dockq",
          "dockq",
          "fnat",
          "interface_rmsd",
          "ligand_rmsd",
          "mapping_status",
          "site_contact_iou",
          "target_contact_recall",
          "target_contact_precision",
          "hotspot_recovery",
          "offsite_contact_fraction",
          "iptm",
          "interface_pae",
          "interface_plddt",
          "clash_count",
          "contact_count"
        ]
      },
      "else": {"required": ["failure_code", "failure_reason"]}
    }
  ]
}
