{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-binder-lane/stage-output-manifest.v1",
  "title": "Stage Output Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage_id", "attempt_id", "artifacts", "output_manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "stage_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_type", "kind", "pattern", "count", "files"],
        "properties": {
          "artifact_id": {"type": "string"},
          "artifact_type": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "pattern": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "published_path": {"type": ["string", "null"]},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "bytes", "records", "ok"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "bytes": {"type": "integer", "minimum": 1},
                "records": {"type": "integer", "minimum": 0},
                "ok": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "output_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
