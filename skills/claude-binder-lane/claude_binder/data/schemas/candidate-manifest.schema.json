{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude-binder-lane/candidate-manifest-row.v1",
  "title": "Candidate Manifest Row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "target_id",
    "target_sha256",
    "candidate_id",
    "parent_candidate_id",
    "origin_generator",
    "generator_mode",
    "sequence_designer",
    "generator_seed",
    "sequence_path",
    "sequence_sha256",
    "sequence_length",
    "structure_path",
    "structure_sha256",
    "design_pose_path",
    "design_pose_sha256",
    "residue_map_sha256",
    "optimization_round",
    "last_optimizer",
    "status"
  ],
  "properties": {
    "target_id": {"type": "string"},
    "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string"},
    "parent_candidate_id": {"type": ["string", "null"]},
    "origin_generator": {"type": "string"},
    "root_backbone_id": {"type": "string"},
    "tm90_cluster_id": {"type": "string"},
    "structure_method": {"type": "string"},
    "seq_method": {"type": "string"},
    "fold_class": {"type": "string"},
    "generator_mode": {"enum": ["backbone-only", "sequence-structure-codesign"]},
    "sequence_designer": {"type": ["string", "null"]},
    "generator_seed": {"type": "integer"},
    "sequence_path": {"type": ["string", "null"]},
    "sequence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "sequence_length": {"type": ["integer", "null"], "minimum": 1},
    "structure_path": {"type": "string"},
    "structure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "design_pose_path": {"type": "string"},
    "design_pose_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "residue_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optimization_round": {"type": "integer", "minimum": 0},
    "last_optimizer": {"type": ["string", "null"]},
    "status": {"enum": ["generated", "sequence-designed", "filtered", "promoted", "failed"]},
    "failure_reason": {"type": ["string", "null"]}
  }
}
