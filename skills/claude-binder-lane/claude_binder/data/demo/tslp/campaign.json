    "minimum_length": 60,
    "maximum_length": 90,
    "target_chain_id": "A",
    "binder_chain_id": "B"
  },
  "controls": {
    "minimum_positive_controls": 1,
    "minimum_negative_controls": 1,
    "positive": [
      {
        "id": "tslp-tslpr-native",
        "role": "known-same-site-complex",
        "enabled": true,
        "structure_path": "structures/tslp-tslpr.pdb",
        "target_chain": "A",
        "binder_chain": "C",
        "gates": [
          {
            "metric": "ipsae_min",
            "operator": "minimum",
            "threshold": 0.8
          },
          {
            "metric": "sc_dockq",
            "operator": "minimum",
            "threshold": 0.1
          },
          {
            "metric": "site_contact_iou",
            "operator": "minimum",
            "threshold": 0.1
          },
          {
            "metric": "target_contact_recall",
            "operator": "minimum",
            "threshold": 0.1
          }
        ]
      },
      {
        "id": "tslp-tezepelumab-heavy",
        "role": "known-same-site-complex",
        "enabled": true,
        "structure_path": "structures/tslp-tezepelumab.pdb",
        "target_chain": "A",
        "binder_chain": "C",
        "gates": [
          {
            "metric": "ipsae_min",
            "operator": "minimum",
            "threshold": 0.8
          },
          {
            "metric": "sc_dockq",
            "operator": "minimum",
            "threshold": 0.1
          },
          {
            "metric": "site_contact_iou",
            "operator": "minimum",
            "threshold": 0.1
          },
          {
            "metric": "target_contact_recall",
            "operator": "minimum",
            "threshold": 0.1
          }
        ]
      }
    ],
    "negative": [
      {
        "id": "tslp-il7ra-alternate-site",
        "role": "alternate-site-complex",
        "enabled": true,
        "structure_path": "structures/tslp-il7ra.pdb",
        "target_chain": "A",
        "binder_chain": "B",
        "gates": [
          {
            "metric": "ipsae_min",
            "operator": "maximum",
            "threshold": 0.2
          },
          {
            "metric": "site_contact_iou",
            "operator": "maximum",
            "threshold": 0.2
          }
        ]
      }
    ],
    "supported_roles": [
      "known-same-site-complex",
      "matched-wrong-pair",
      "sequence-decoy",
      "pose-decoy",
      "alternate-site-complex"
    ]
  },
  "filters": {
    "disabled_checks": [],
    "liability_rules": {
      "reject_odd_cysteine_count": true,
      "maximum_homopolymer_run": 4,
      "hydrophobic_window_length": 12,
      "maximum_hydrophobic_residues": 7
    },
    "required_checks": [
      "composition",
      "exact_duplicates",
      "liability_chemistry",
      "sequence_novelty",
      "model_likelihood"
    ],
    "contracts": [
      {
        "filter_id": "composition",
        "stage_id": "filter-integrity",
        "metric": "composition-pass",
        "operator": "minimum",
        "threshold": 1.0,
        "tool_revision": "local-fixture-v1",
        "reference_revision": "local-fixture-reference-v1",
        "reference_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      {
        "filter_id": "exact_duplicates",
        "stage_id": "filter-integrity",
        "metric": "unique-sequence-pass",
        "operator": "minimum",
        "threshold": 1.0,
        "tool_revision": "local-fixture-v1",
        "reference_revision": "local-fixture-reference-v1",
        "reference_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      {
        "filter_id": "liability_chemistry",
        "stage_id": "filter-integrity",
        "metric": "liability-chemistry-pass",
        "operator": "minimum",
        "threshold": 1.0,
        "tool_revision": "claude-binder-liability-v1",
        "reference_revision": "none",
        "reference_sha256": "not_applicable: reference revision none uses no external reference data"
      },
      {
        "filter_id": "sequence_novelty",
        "stage_id": "filter-novelty",
        "metric": "maximum-target-chain-window-identity",
        "operator": "maximum",
        "threshold": 0.6,
        "tool_revision": "claude-binder-target-chain-window-v1",
        "reference_revision": "local",
        "reference_sha256": "not_applicable: reference revision local uses no external reference data"
      },
      {
        "filter_id": "model_likelihood",
        "stage_id": "filter-novelty",
        "metric": "model-likelihood-pass",
        "operator": "minimum",
        "threshold": 1.0,
        "tool_revision": "local-fixture-v1",
        "reference_revision": "local-fixture-reference-v1",
        "reference_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      }
    ],
    "metric_sources": {
      "sequence_novelty": {
        "kind": "target-chain-sliding-window",
        "window_length": 40,
        "include_positive_controls": true,
        "description": "Compare every design with every protein chain in each target structure and enabled positive-control structure. The 40-residue window is the protocol's minimum local-alignment span. Applying it as an ungapped window is a configurable product judgement."
      }
    }
  },
  "scoring": {
    "primary_metric": "ipsae_min",
    "pose_metric": "sc_dockq",
    "rank_weights": {
      "ipsae_min_z": 0.8,
      "sc_dockq_z": 0.2
    },
    "counter_screen": {
      "off_target_paralog_id": "TODO: TSLP has no configured paralog antitarget in this demo. The alternate-site negative control carries the specificity test instead."
    },
    "seed_aggregation": "max",
    "minimum_seed_observations": 5,
    "seed_reduction": "maximum-ipsae_min-per-predictor",
    "normalization": "population-z-score-within-target-predictor-and-metric",
    "implementations": {
      "ipsae_revision": "fixture-ipsae-v1",
      "ipsae_interface_cutoff_angstrom": 10.0,
      "dockq_revision": "fixture-dockq-v1",
      "site_scorer_revision": "fixture-site-scorer-v1",
      "site_metric_basis": "selected-cofold-pose",
      "minimum_aligned_target_residues": 20,
      "maximum_target_alignment_rmsd": 2.0
    },
