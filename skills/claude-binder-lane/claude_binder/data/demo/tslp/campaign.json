{
  "schema_version": 1,
  "template_id": "claude-binder-lane.v1",
  "campaign_id": "tslp-tslpr-site-demo",
  "run_id": "tslp-tslpr-site-demo-v1",
  "purpose": "Design binders against the TSLPR-engaging face of human TSLP, the face the approved antibody tezepelumab also covers. Compose without executing a provider stage.",
  "declared_use": "non-commercial",
  "_provider_endpoints_comment": "This campaign carries no provider_endpoints block. An endpoint field is enforced only when an adapter command template references its token, and no Modal adapter does. See references/modal-bring-up.md for the two Modal values you supply instead.",
