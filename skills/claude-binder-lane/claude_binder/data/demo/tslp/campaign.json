  "optimization": {
    "enabled": true,
    "rounds": 2,
    "early_stop_margin": null,
    "parent_count_per_round": 3,
    "variants_per_parent": 1,
    "operators": [
      "partial-diffusion",
      "inverse-folding-resample",
      "predict-redesign",
      "point-mutation"
    ],
    "adapter_policies": [
      {
        "adapter_id": "optimization-controller",
        "operations": [
          "partial-diffusion",
          "inverse-folding-resample",
          "predict-redesign",
          "point-mutation"
        ],
        "parameter_ranges": {
          "diffusion_fraction": {
            "type": "number",
